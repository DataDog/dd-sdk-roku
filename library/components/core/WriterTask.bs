import "pkg:/source/datadogSdk.bs"
import "pkg:/source/fileUtils.bs"
import "pkg:/source/internalLogger.bs"
import "pkg:/source/immutableRecords.bs"
import "pkg:/source/rum/viewSnapshots.bs"

sub init()
    m.port = CreateObject("roMessagePort")
    m.top.observeFieldScoped("writeEvent", m.port)
    m.top.observeFieldScoped("trackType", m.port)
    m.top.observeFieldScoped("storageScope", m.port)
    m.top.observeFieldScoped("instanceId", m.port)
    m.top.observeFieldScoped("snapshotEvent", m.port)
    m.trackType = m.top.trackType
    m.storageScope = m.top.storageScope
    m.instanceId = m.top.instanceId
    m.top.functionName = "writerLoop"
    m.top.control = "RUN"
end sub

sub writerLoop()
    while (true)
        msg = wait(0, m.port)
        if (type(msg) = "roSGNodeEvent")
            fieldName = msg.getField()
            if (fieldName = "writeEvent")
                onWriteEvent(msg.getData())
            else if (fieldName = "snapshotEvent")
                onSnapshotEvent(msg.getData())
            else if (fieldName = "instanceId")
                m.instanceId = msg.getData()
            else if (fieldName = "trackType")
                m.trackType = msg.getData()
            else if (fieldName = "storageScope")
                m.storageScope = msg.getData()
            end if
        end if
    end while
end sub

' Every event owns a fresh path. Never append to or replace a previous event.
sub onWriteEvent(event as string)
    if (event = "")
        return
    end if
    if (m.trackType = "" or not isRecordHex(m.storageScope, 64))
        ddLogWarning("Event storage is not configured")
        return
    end if
    folderPath = trackFolderPath(m.trackType)
    ' Another writer may create the directory after our existence check.
    ' Let the checked write decide whether the path is usable.
    mkDirs(folderPath)
    result = writeImmutableRecord(folderPath, m.storageScope, event)
    if (result.status <> "verified")
        ' A partial/uncertain file is retained; do not retry into the same path.
        ddLogWarning("Unable to verify event write: " + result.status)
    end if
end sub

sub onSnapshotEvent(event as object)
    if (m.trackType <> TrackType.rum)
        return
    end if
    folder = trackFolderPath(m.trackType)
    mkDirs(folder)
    result = writeViewSnapshot(folder, m.storageScope, m.instanceId, event)
    if (result.status <> "verified")
        ddLogWarning("Unable to update view snapshot: " + result.status)
    end if
end sub
