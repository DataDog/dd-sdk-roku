import "pkg:/source/datadogSdk.bs"
import "pkg:/source/internalLogger.bs"
import "pkg:/source/fileUtils.bs"
import "pkg:/source/timeUtils.bs"
import "pkg:/source/batchCleanupTelemetry.bs"
import "pkg:/source/immutableRecords.bs"
import "pkg:/source/recordCompletion.bs"

' *****************************************************************
' * MultiTrackUploaderTask: a background loop checking for files available for upload;
' * When a file is ready, it is uploaded, and upon success deleted from disk.
' * It can look into different folders with distinct configurations
' *****************************************************************

' ----------------------------------------------------------------
' Initialize the component
' ----------------------------------------------------------------
sub init()
    m.top.functionName = "uploaderLoop"
    ' Callers must set fields, then set control to "RUN"
end sub

' ----------------------------------------------------------------
' Registers one track without replacing concurrent registrations from other agents.
' Public callFunc runs on the render thread; the worker receives the tracks event.
' Keep all network/filesystem work in the uploader loop, outside this function.
' ----------------------------------------------------------------
sub registerTrack(trackId as string, trackInfo as object)
    tracks = m.top.tracks ?? {}
    tracks[trackId] = trackInfo
    m.top.tracks = tracks
end sub

' ----------------------------------------------------------------
' Main uploader loop
' ----------------------------------------------------------------
sub uploaderLoop()
    ddLogThread("MultiTrackUploaderTask.uploaderLoop()")

    ' Uploader's dependencies
    m.deviceInfo = CreateObject("roDeviceInfo")

    ' Cache static interface fields locally to avoid per-iteration rendezvous.
    m.waitPeriodMs = m.top.waitPeriodMs
    m.clientToken = m.top.clientToken

    ' Observe `tracks` so we refresh the local cache when agents (re)register a track.
    ' Observer must be registered before the initial read to avoid losing a concurrent update.
    m.port = createObject("roMessagePort")
    m.top.observeFieldScoped("tracks", m.port)
    m.tracks = m.top.tracks

    while (true)
        ddLogVerbose("Multi Track Uploader loop sync")
        uploadAvailableFiles()
        ddLogVerbose("Nothing else to do, waiting for " + m.waitPeriodMs.toStr() + "ms")
        drainPortMessages(wait(m.waitPeriodMs, m.port))
    end while
end sub

' ----------------------------------------------------------------
' Drain any queued port messages and refresh local caches accordingly.
' @param msg (dynamic) the first message returned by wait(), or invalid on timeout
' ----------------------------------------------------------------
sub drainPortMessages(msg as dynamic)
    while (msg <> invalid)
        if (type(msg) = "roSGNodeEvent" and msg.getField() = "tracks")
            m.tracks = msg.getData()
            ddLogVerbose("MultiTrackUploaderTask: tracks updated")
        end if
        msg = m.port.GetMessage()
    end while
end sub

' ----------------------------------------------------------------
' Looks for all uploadable files, and upload them one by one
' ----------------------------------------------------------------
sub uploadAvailableFiles()
    ensureRecordCompletion()
    cleanupCompletedRecords()
    tracks = m.tracks
    if (tracks <> invalid and GetInterface(tracks, "ifAssociativeArray") <> invalid)
        for each track in tracks
            ddLogVerbose("Checking files to upload for track " + track)
            trackInfo = tracks[track]
            uploadAvailableFilesForTrack(trackInfo)
        end for
    end if
end sub

' ----------------------------------------------------------------
' Looks for all uploadable files for the given track, and upload them one by one
' @param trackInfo (object) the configuration for the current track
' ----------------------------------------------------------------
sub uploadAvailableFilesForTrack(trackInfo as object)
    if (trackInfo.trackType <> invalid)
        folderPath = trackFolderPath(trackInfo.trackType)
        ddLogVerbose("Checking files in folder " + folderPath)

        filenames = ListDir(folderPath)
        for each filename in filenames
            filePath = folderPath + "/" + filename
            if (isFileValidForUpload(filename))
                requestId = m.deviceInfo.GetRandomUUID()
                responseCode = uploadFile(filePath, trackInfo, requestId)
                handleResponse(requestId, responseCode, filePath, trackInfo)
            else
                ddLogVerbose("Ignoring file " + filename)
            end if
        end for
        uploadImmutableRecords(folderPath, filenames, trackInfo)
    end if
end sub

' ----------------------------------------------------------------
' Verify if the given file is uploadable, meaning it's name is a timestamp,
' and it's old enough that no writer will attempt appending data in it.
' @param path (string) the path of the file to upload
' @return (boolean) if the file is valid for upload
' ----------------------------------------------------------------
function isFileValidForUpload(filename as string) as boolean
    timestamp = parseLegacyBatchTimestamp(filename)
    if (timestamp = invalid)
        ddLogVerbose("File " + filename + " is not uploadable")
        return false
    end if

    fileTimestamp& = timestamp
    uploadTimestamp& = fileTimestamp& + 30000
    currentTimestamp& = getTimestamp()
    if (uploadTimestamp& > currentTimestamp&)
        remaining = millisToSec(uploadTimestamp& - currentTimestamp&)
        ddLogVerbose("File " + filename + " is not uploadable yet, will be in " + remaining.toStr() + "s")
        return false
    end if

    return true
end function

' ----------------------------------------------------------------
' Get the upload url for the current track
' @param trackInfo (object) the configuration for the current track
' @return (string) the url to upload the data to
' ----------------------------------------------------------------
function getUploadUrl(trackInfo as object) as string

    url = trackInfo.url
    if (trackInfo.queryParams <> invalid)
        m.urlEscaper = m.urlEscaper ?? CreateObject("roUrlTransfer")
        first = true
        for each key in trackInfo.queryParams
            ddLogVerbose("Found query params " + key)
            prefix = ""
            if (first)
                prefix = "?"
            else
                prefix = "&"
            end if
            ' URL-encode the value so reserved/whitespace characters (e.g. in the user-provided env) keep the query string well-formed
            url = url + prefix + key + "=" + m.urlEscaper.Escape(trackInfo.queryParams[key])
            first = false
        end for
    else
        ddLogVerbose("No query parameters")
    end if

    return url
end function

' ----------------------------------------------------------------
' Uploads the content of the given file to Datadog
' @param path (string) the path of the file to upload
' @param trackInfo (object) the configuration for the current track
' @param requestId (string) the unique identifier for this request
' @return (integer) the upload status code
' ----------------------------------------------------------------
function uploadFile(path as string, trackInfo as object, requestId as string) as integer
    ensureNetworkClient()

    url = getUploadUrl(trackInfo)
    headers = getUploadHeaders(trackInfo.contentType, requestId)

    ddLogVerbose("Network request " + requestId + " from " + path + " to " + url)
    result = m.networkClient@.postFromFile(url, path, headers, trackInfo.payloadPrefix, trackInfo.payloadPostfix)
    return result
end function

' ----------------------------------------------------------------
' Logs and classifies the response; true means retain the payload for retry.
' @param requestId (string) the unique identifier for this request
' @param responseCode (integer) the HTTP status code of the upload request
' - 2xx: successful response, the batch can be removed.
' - 400 Bad Request: the server cannot or will not process the request (client error).
'     The client SHOULD NOT retry this request.
' - 401 Unauthorized: the request lacks valid authentication credentials.
'     The client SHOULD NOT retry this request.
' - 403 Forbidden: the server understood the request but refuses to authorize it (invalid credentials, …).
'     The client SHOULD NOT retry this request.
' - 408 Request Timeout:
'     The client SHOULD retry this request.
' - 413 Payload Too Large: the request entity is larger than limits defined by server.
'     The client SHOULD NOT retry this request.
' - 429 Too Many Requests: the user has sent too many requests in a given amount of time.
'     The client SHOULD retry this request.
' - 500 Internal Server Error: the server encountered an unexpected condition.
'     The client SHOULD retry this request.
' - 503 Service Unavailable: the server is not ready to handle the request probably because it is overloaded.
'     The client SHOULD retry this request.
' @param filePath (string) the path of the file that was uploaded
' @param trackInfo (object) the configuration for the current track
' ----------------------------------------------------------------
function shouldRetryUploadResponse(requestId as string, responseCode as integer, filePath as string, trackInfo as object) as boolean
    ' Preserve pending data unless the response explicitly permits removal.
    ' This includes transport errors (negative codes), unknown responses, and all 5xx.
    if (responseCode >= 200 and responseCode < 300)
        ddLogInfo("Upload to track " + trackInfo.trackType + " succeeded.")
        retry = false
    else if (responseCode = 400)
        ddLogError("Upload to track " + trackInfo.trackType + " failed, data will be discarded;")
        ddLogError("The intake server returned status code 400 Bad Request, try updating the SDK to the latest version, or contact the support.")
        ddLogError("DD-REQUEST-ID:" + requestId)
        if (filePath <> "")
            ddLogError("Uploaded data was:" + chr(10) + ReadAsciiFile(filePath))
        end if
        retry = false
    else if (responseCode = 401)
        ddLogError("Upload to track " + trackInfo.trackType + " failed, data will be discarded;")
        ddLogError("The intake server returned status code 401 Unauthorized, please check your ClientToken is correct and still valid.")
        retry = false
    else if (responseCode = 403)
        ddLogError("Upload to track " + trackInfo.trackType + " failed, data will be discarded;")
        ddLogError("The intake server returned status code 403 Forbidden, please check your ClientToken is correct and still valid.")
        retry = false
    else if (responseCode = 408)
        ddLogWarning("Upload to track " + trackInfo.trackType + " timed out, we'll retry later")
        retry = true
    else if (responseCode = 413)
        ddLogError("Upload to track " + trackInfo.trackType + " failed, data will be discarded;")
        ddLogError("The intake server returned status code 413 Payload Too Large, please check the number of custom attributes you attached to your events, or contact the support.")
        retry = false
    else if (responseCode = 429)
        ddLogWarning("Upload to track " + trackInfo.trackType + " failed, we'll retry later;")
        ddLogWarning("The intake server returned status code 429 Too Many Requests; if you think this shouldn't happen, please contact the support.")
        retry = true
    else if (responseCode = 500)
        ddLogWarning("Upload to track " + trackInfo.trackType + " failed, we'll retry later;")
        ddLogWarning("The intake server returned status code 500 Internal Server Error; if the issue persists, please contact the support.")
        retry = true
    else if (responseCode = 502)
        ddLogWarning("Upload to track " + trackInfo.trackType + " failed, we'll retry later;")
        ddLogWarning("The intake server returned status code 502 Bad Gateway; if the issue persists, please contact the support.")
        retry = true
    else if (responseCode = 503)
        ddLogWarning("Upload to track " + trackInfo.trackType + " failed, we'll retry later;")
        ddLogWarning("The intake server returned status code 503 Unavailable; if the issue persists, please contact the support.")
        retry = true
    else if (responseCode = 504)
        ddLogWarning("Upload to track " + trackInfo.trackType + " failed, we'll retry later;")
        ddLogWarning("The intake server returned status code 504 Gateway Timeout; if the issue persists, please contact the support.")
        retry = true
    else if (responseCode = 507)
        ddLogWarning("Upload to track " + trackInfo.trackType + " failed, we'll retry later;")
        ddLogWarning("The intake server returned status code 507 Insufficient Storage; if the issue persists, please contact the support.")
        retry = true
    else if (responseCode >= 500 and responseCode < 600)
        ddLogWarning("Upload to track " + trackInfo.trackType + " failed, we'll retry later;")
        ddLogWarning("The intake server returned status code " + responseCode.toStr() + "; if the issue persists, please contact the support.")
        retry = true
    else if (responseCode >= 400 and responseCode < 500)
        ddLogWarning("Upload to track " + trackInfo.trackType + " failed, data will be discarded;")
        ddLogWarning("The intake server returned status code " + responseCode.toStr() + "; if the issue persists, please contact the support.")
        retry = false
    else
        ddLogWarning("Upload to track " + trackInfo.trackType + " status unknown, keeping data for retry;")
        ddLogWarning("The intake server returned status code " + responseCode.toStr() + "; if the issue persists, please contact the support.")
        retry = true
    end if

    return retry
end function

sub handleResponse(requestId as string, responseCode as integer, filePath as string, trackInfo as object)
    if (not shouldRetryUploadResponse(requestId, responseCode, filePath, trackInfo))
        cleanupUploadedFile(filePath)
    end if
end sub

sub cleanupUploadedFile(filePath as string)
    ddLogVerbose("Deleting file at " + filePath)
    if (not deleteFileIfPresent(filePath))
        reportBatchCleanupFailure(filePath)
    end if
end sub

sub reportBatchCleanupFailure(filePath as string)
    message = "Unable to delete batch file at " + filePath
    ddLogWarning(message)
    datadogRumAgent = m.global.datadogRumAgent
    if (datadogRumAgent <> invalid)
        error = nextBatchCleanupError(filePath)
        if (error <> invalid)
            datadogRumAgent@.addErrorTelemetry(error)
        end if
    end if
end sub

' Limit new cleanup telemetry, without changing uploads or file disposition.
' Already-persisted telemetry may still be retransmitted by the upload path.
function nextBatchCleanupError(filePath as string) as dynamic
    if (m.cleanupTelemetryBudget = invalid)
        m.cleanupTelemetryBudget = newBatchCleanupTelemetryBudget()
    end if
    suppressed = m.cleanupTelemetryBudget.nextReport()
    if (suppressed < 0)
        return invalid
    end if
    message = "Unable to delete batch file at " + filePath
    if (suppressed > 0)
        message += "; suppressed at least " + suppressed.toStr() + " additional cleanup errors since previous report"
    end if
    return { number: 0, message: message, backtrace: [] }
end function

' ----------------------------------------------------------------
' Sets the internal network client from the top node's field,
' or instantiate one.
' ----------------------------------------------------------------
sub ensureNetworkClient()
    if (m.networkClient = invalid)
        if (m.top.networkClient <> invalid)
            m.networkClient = m.top.networkClient
        else
            m.networkClient = CreateObject("roSGNode", "NetworkClient")
        end if
    end if
end sub


function getUploadHeaders(contentType as string, requestId as string) as object
    headers = {}
    headers["Content-Type"] = contentType
    headers["DD-API-KEY"] = m.clientToken
    headers["DD-EVP-ORIGIN"] = agentSource()
    headers["DD-EVP-ORIGIN-VERSION"] = sdkVersion()
    headers["DD-REQUEST-ID"] = requestId

    return headers
end function

' Group only verified snapshots for this destination. An oversized single event
' is sent alone, matching the existing soft batch-size policy rather than stalling.
sub uploadImmutableRecords(folderPath as string, filenames as object, trackInfo as object)
    ensureRecordCompletion()
    scope = trackInfo.storageScope
    if (scope = invalid)
        return
    end if
    if (not isRecordHex(scope, 64))
        return
    end if
    separator = trackInfo.payloadSeparator ?? chr(10)
    separatorBytes = CreateObject("roByteArray")
    separatorBytes.FromAsciiString(separator)
    records = []
    payload = ""
    byteCount = 0
    for each filename in filenames
        if (records.Count() > 0 and records.Count() >= m.recordCompletion.remaining())
            uploadImmutableGroup(folderPath, records, payload, trackInfo)
            records = []
            payload = ""
            byteCount = 0
        end if
        if (m.recordCompletion.remaining() = 0)
            return
        end if
        record = invalid
        if (not m.recordCompletion.isKnown(folderPath + "/" + filename))
            record = readImmutableRecord(folderPath, filename, scope)
        end if
        if (record <> invalid)
            nextSize = byteCount + record.byteCount
            if (records.Count() > 0)
                nextSize += separatorBytes.Count()
            end if
            if (records.Count() > 0 and (nextSize > 16384 or records.Count() >= 64))
                uploadImmutableGroup(folderPath, records, payload, trackInfo)
                records = []
                payload = ""
                byteCount = 0
                if (m.recordCompletion.remaining() = 0)
                    return
                end if
            end if
            if (records.Count() > 0)
                payload += separator
                byteCount += separatorBytes.Count()
            end if
            payload += record.payload
            byteCount += record.byteCount
            records.Push(record.filename)
        end if
    end for
    if (records.Count() > 0)
        uploadImmutableGroup(folderPath, records, payload, trackInfo)
    end if
end sub

sub uploadImmutableGroup(folderPath as string, records as object, payload as string, trackInfo as object)
    ensureRecordCompletion()
    paths = []
    for each filename in records
        paths.Push(folderPath + "/" + filename)
    end for
    if (not m.recordCompletion.reserve(paths))
        return
    end if
    ensureNetworkClient()
    requestId = m.deviceInfo.GetRandomUUID()
    headers = getUploadHeaders(trackInfo.contentType, requestId)
    body = trackInfo.payloadPrefix + payload + trackInfo.payloadPostfix
    response = m.networkClient@.postPayload(getUploadUrl(trackInfo), body, headers)
    if (shouldRetryUploadResponse(requestId, response, "", trackInfo))
        m.recordCompletion.release(paths)
    else
        ' Remember ALL terminal records before the first deletion can fail.
        m.recordCompletion.complete(paths)
        cleanupCompletedRecords()
    end if
end sub

sub ensureRecordCompletion()
    if (m.recordCompletion = invalid)
        m.recordCompletion = newRecordCompletionState()
    end if
    if (m.recordCleanupIO = invalid)
        m.recordCleanupIO = {
            remove: function(path as string) as boolean
                return deleteFileIfPresent(path)
            end function
        }
    end if
end sub

sub cleanupCompletedRecords()
    for each path in m.recordCompletion.cleanupDue()
        removed = m.recordCleanupIO.remove(path)
        m.recordCompletion.cleanupResult(path, removed)
        if (not removed)
            reportBatchCleanupFailure(path)
        end if
    end for
end sub
