import "pkg:/source/roku_modules/datadogroku/wrapper/DdUrlTransfer.brs"
import "pkg:/source/roku_modules/datadogroku/rum/rumRawEvents.brs"
import "pkg:/source/roku_modules/datadogroku/timeUtils.brs"

sub init()
    m.top.functionName = "performTest"
end sub

sub performTest()
    datadogroku_ddLogThread("NetworkTestTask.performTest()")
    result = {
        operation: m.top.operation
    }
    operationName = m.top.operation

    result = {}
    try
        if (operationName = "GetToString")
            result = GetToString()
        else if (operationName = "GetToFile")
            result = GetToFile()
        else if (operationName = "PostFromString")
            result = PostFromString()
        else if (operationName = "PostFromFile")
            result = PostFromFile()
        else if (operationName = "Add Resources Batch")
            result = AddResourcesBatch()
        else
            result.error = "Operation '" + m.top.operation + "' is not implemented yet"
        end if
    catch error
        result.error = error.message
        m.global.datadogRumAgent@.addError(error)
        datadogroku_ddLogError("Oups", error)
    end try

    result.operation = operationName

    m.top.result = result
end sub

function GetToString() as object
    ddUrlTransfer = datadogroku_DdUrlTransfer(m.global)
    sleep(100)
    url = m.global.mirrorUrl + "?via=GetToString"
    ddUrlTransfer.SetUrl(url)
    ddUrlTransfer.EnablePeerVerification(false)
    ddUrlTransfer.EnableHostVerification(false)
    result = ddUrlTransfer.GetToString()
    return {
        response: result
    }
end function

function GetToFile() as object
    ddUrlTransfer = datadogroku_DdUrlTransfer(m.global)
    url = m.global.mirrorUrl + "?via=GetToFile"
    filename = "tmp:/localfile"
    ddUrlTransfer.SetUrl(url)
    ddUrlTransfer.SetRequest("POST")
    ddUrlTransfer.EnablePeerVerification(false)
    ddUrlTransfer.EnableHostVerification(false)
    result = ddUrlTransfer.GetToFile(filename)
    return {
        statusCode: result.toStr(),
        response: ReadAsciiFile(filename)
    }
end function

function PostFromString() as object
    ddUrlTransfer = datadogroku_DdUrlTransfer(m.global)
    url = m.global.mirrorUrl + "?via=PostFromString"
    postBody = "Lorem ipsum dolor sit amet"
    ddUrlTransfer.SetUrl(url)
    ddUrlTransfer.EnablePeerVerification(false)
    ddUrlTransfer.EnableHostVerification(false)
    result = ddUrlTransfer.PostFromString(postBody)
    return {
        statusCode: result.toStr()
    }
end function

function PostFromFile() as object
    ddUrlTransfer = datadogroku_DdUrlTransfer(m.global)
    url = m.global.mirrorUrl + "?via=PostFromFile"
    filename = "tmp:/localfile"
    postBody = "Lorem ipsum dolor sit amet"
    WriteAsciiFile(filename, postBody)
    ddUrlTransfer.SetUrl(url)
    ddUrlTransfer.EnablePeerVerification(false)
    ddUrlTransfer.EnableHostVerification(false)
    result = ddUrlTransfer.PostFromFile(filename)
    return {
        statusCode: result.toStr()
    }
end function

' Builds a batch of pre-built resource events and reports them all in a single
' cross-thread rendezvous via the addResources field, instead of one set per
' resource.
function AddResourcesBatch() as object
    ' The click that triggered this is what produces the resources, so stamp each
    ' one just after "now" (staggered 50ms apart) so they render after the
    ' triggering click, in order. We set startTime explicitly (the field RUM
    ' prefers); without it, RUM back-dates the start as (now - transferTime),
    ' which reorders same-instant resources by their transfer duration.
    now& = datadogroku_getTimestamp()
    events = []
    for i = 1 to 3
        resource = {
            url: "https://example.com/batch/resource" + i.toStr(),
            method: "GET",
            transferTime: 0.05,
            httpCode: 200,
            status: "ok",
            startTime: now& + (i * 50)
        }
        events.push(datadogroku_addResourceEvent(resource, { batch_index: i }))
    end for
    m.global.datadogRumAgent.addResources = events
    return {
        reported: events.count().toStr()
    }
end function
