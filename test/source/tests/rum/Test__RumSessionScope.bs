    fakeStopEvent = { eventType: "stopFeatureOperation", name: fakeName, operationKey: fakeKey, vitalId: fakeVitalId2, context: {} }

    existingUpdates = m.mockWriter@.getFieldUpdates("writeEvent")
    existingCount = existingUpdates.count()

    ' When
