'----------------------------------------------------------------
function RumAgentTest__WhenFailOperationWithDisallowedCharacterInName_ThenDispatchWithWarning() as string
    ' Given
    invalidNames = ["user login", "api/v1", "checkout:step", "a,b", "login!", "a+b", "ログイン", "café"]

    ' When
    for each invalidName in invalidNames
        m.testedNode@.failOperation(invalidName, "error", invalid)
    end for
    sleep(30)

    ' Then — one handleEvent dispatch per invalid name; name is preserved.
    ' Compared as a set (not by index) since dispatch is not guaranteed to
    ' preserve call order.
    calls = m.mockRumScope@.captureFunctionCalls("handleEvent", { event: { eventType: "stopFeatureOperation" } })
    Assert.that(calls).isNotInvalid().hasSize(invalidNames.Count())
    dispatchedNames = []
    for each call in calls
        dispatchedNames.push(call.event.name)
    end for
    for each invalidName in invalidNames
        Assert.that(dispatchedNames).contains(invalidName)
    end for
    return ""
end function

'----------------------------------------------------------------
' Given: a RumAgent
'  When: call the startOperation method with a blank name
'  Then: do not dispatch any event to the RumScope (the backend
'        rejects blank/empty names with its own non-empty precondition).
'----------------------------------------------------------------
function RumAgentTest__WhenStartOperationWithBlankName_ThenDoNotDispatch() as string
    ' When
    m.testedNode@.startOperation("", invalid)
    sleep(30)

    ' Then
    return m.mockRumScope@.assertNoInteractions()
end function

'----------------------------------------------------------------
' Given: a RumAgent
'  When: call the startOperation method with a whitespace-only name
'  Then: do not dispatch any event to the RumScope
'----------------------------------------------------------------
function RumAgentTest__WhenStartOperationWithWhitespaceName_ThenDoNotDispatch() as string
    ' When
    m.testedNode@.startOperation("   ", invalid)
    sleep(30)

    ' Then
    return m.mockRumScope@.assertNoInteractions()
end function

'----------------------------------------------------------------
' Given: a RumAgent
'  When: call the startOperation method with a name containing
'        characters outside the schema facet-path character set
'        (letters / digits / - _ . @ $)
'  Then: dispatch the event anyway — the backend owns the authoritative
'        character-set policy, so client-side drop would force a
'        customer SDK bump if that policy is ever relaxed. The agent
'        still logs a WARNING to flag the suspicious name.
'----------------------------------------------------------------
function RumAgentTest__WhenStartOperationWithDisallowedCharacterInName_ThenDispatchWithWarning() as string
    ' Given — includes a non-ASCII name to pin the ASCII-only \w semantics
    ' of BrightScript roRegex (PCRE).
    invalidNames = ["user login", "api/v1", "checkout:step", "a,b", "login!", "a+b", "ログイン", "café"]

    ' When
    for each invalidName in invalidNames
        m.testedNode@.startOperation(invalidName, invalid)
    end for
    sleep(30)

    ' Then — one handleEvent dispatch per invalid name; name is preserved.
    ' Compared as a set (not by index) since dispatch is not guaranteed to
    ' preserve call order.
    calls = m.mockRumScope@.captureFunctionCalls("handleEvent", { event: { eventType: "startFeatureOperation" } })
    Assert.that(calls).isNotInvalid().hasSize(invalidNames.Count())
    dispatchedNames = []
    for each call in calls
        dispatchedNames.push(call.event.name)
    end for
    for each invalidName in invalidNames
        Assert.that(dispatchedNames).contains(invalidName)
    end for
    return ""
end function

'----------------------------------------------------------------
' Given: a RumAgent
'  When: call the startOperation method with names that use only
'        schema-allowed characters (letters, digits, - _ . @ $)
'  Then: dispatch every event to the RumScope
'----------------------------------------------------------------
function RumAgentTest__WhenStartOperationWithAllowedSchemaCharacters_ThenDispatch() as string
    ' Given
    validNames = ["login", "step42", "login-v2", "user_login", "login.v2", "login@prod", "login$1", "LoginV2"]

    ' When
    for each validName in validNames
        m.testedNode@.startOperation(validName, invalid)
    end for
    sleep(30)

    ' Then — one handleEvent dispatch per valid name
    calls = m.mockRumScope@.captureFunctionCalls("handleEvent", { event: { eventType: "startFeatureOperation" } })
    Assert.that(calls).isNotInvalid().hasSize(validNames.Count())
    return ""
end function

'----------------------------------------------------------------
' Given: a RumAgent
'  When: call the startOperation method with an operationKey
'        containing characters outside the name character set
'        (spaces, slashes)
'  Then: dispatch the event — operation_key has no character
'        restriction in the schema
'----------------------------------------------------------------
function RumAgentTest__WhenStartOperationWithSpacedOperationKey_ThenDispatch() as string
    ' Given
    fakeKey = "session 42 / user foo"

    ' When
    m.testedNode@.startOperation("login", fakeKey)
    sleep(30)

    ' Then
    calls = m.mockRumScope@.captureFunctionCalls("handleEvent", { event: { eventType: "startFeatureOperation" } })
    Assert.that(calls).isNotInvalid().hasSize(1)
    Assert.that(calls[0].event.operationKey).isEqualTo(fakeKey)
    return ""
end function

'----------------------------------------------------------------
' Given: a RumAgent
'  When: call the startOperation method with nil operationKey
'  Then: dispatch the event (nil key means unkeyed operation)
'----------------------------------------------------------------
function RumAgentTest__WhenStartOperationWithNilKey_ThenDispatch() as string
    ' Given
    fakeName = IG_GetString(32)

    ' When
    m.testedNode@.startOperation(fakeName, invalid)
    sleep(30)

    ' Then
    calls = m.mockRumScope@.captureFunctionCalls("handleEvent", { event: { eventType: "startFeatureOperation" } })
    Assert.that(calls).isNotInvalid().hasSize(1)
    capturedEvent = calls[0].event
    Assert.that(capturedEvent.name).isEqualTo(fakeName)
    Assert.that(capturedEvent.operationKey).isEqualTo(invalid)
    return ""
end function

'----------------------------------------------------------------
' Given: a RumAgent
'  When: call the startOperation method with a blank operationKey
'  Then: dispatch the event anyway — operationKey is optional, so a
'        malformed value is never grounds to drop the step. The agent
'        still logs a WARNING to flag the suspicious key.
'----------------------------------------------------------------
function RumAgentTest__WhenStartOperationWithBlankKey_ThenDispatchWithWarning() as string
    ' Given
    fakeName = IG_GetString(32)

    ' When
    m.testedNode@.startOperation(fakeName, "")
    sleep(30)

    ' Then
    calls = m.mockRumScope@.captureFunctionCalls("handleEvent", { event: { eventType: "startFeatureOperation" } })
    Assert.that(calls).isNotInvalid().hasSize(1)
    Assert.that(calls[0].event.operationKey).isEqualTo("")
    return ""
end function

'----------------------------------------------------------------
' Given: a RumAgent
'  When: call the startOperation method with a whitespace-only operationKey
'  Then: dispatch the event anyway — see blank-key test above.
'----------------------------------------------------------------
function RumAgentTest__WhenStartOperationWithWhitespaceKey_ThenDispatchWithWarning() as string
    ' Given
    fakeName = IG_GetString(32)

    ' When
    m.testedNode@.startOperation(fakeName, "   ")
    sleep(30)

    ' Then
    calls = m.mockRumScope@.captureFunctionCalls("handleEvent", { event: { eventType: "startFeatureOperation" } })
    Assert.that(calls).isNotInvalid().hasSize(1)
    Assert.that(calls[0].event.operationKey).isEqualTo("   ")
    return ""
end function

'----------------------------------------------------------------
' Given: a RumAgent
'  When: call the startOperation method with a non-string, non-invalid
'        operationKey (a caller-side type error, not a schema concern)
'  Then: do not dispatch any event to the RumScope
'----------------------------------------------------------------
function RumAgentTest__WhenStartOperationWithNonStringKey_ThenDoNotDispatch() as string
    ' Given
    fakeName = IG_GetString(32)

    ' When
