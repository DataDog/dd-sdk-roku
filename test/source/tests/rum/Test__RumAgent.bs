'----------------------------------------------------------------
' Given: a RumAgent
'  When: set the addResources field with an array of pre-built resource events
'  Then: delegates each event to the root RumScope
'----------------------------------------------------------------
function RumAgentTest__WhenAddResources_ThenDelegateToRumScope() as string
    ' Given
    fakeEvent1 = { eventType: "addResource", resource: { url: IG_GetString(128) } }
    fakeEvent2 = { eventType: "addResource", resource: { url: IG_GetString(128) } }

    ' When
    m.testedNode.addResources = [fakeEvent1, fakeEvent2]
    sleep(30)

    ' Then
    result = m.mockRumScope@.assertFunctionCalled("handleEvent", { event: fakeEvent1, writer: m.mockWriter })
    result += m.mockRumScope@.assertFunctionCalled("handleEvent", { event: fakeEvent2, writer: m.mockWriter })
    return result
end function

'----------------------------------------------------------------
' Given: a RumAgent
'  When: set the addResources field with an empty array
'  Then: dispatches nothing to the root RumScope
'----------------------------------------------------------------
function RumAgentTest__WhenAddResourcesIsEmpty_ThenDoNotDispatch() as string
    ' When
    m.testedNode.addResources = []
    sleep(30)

    ' Then
    return m.mockRumScope@.assertFunctionCalled("handleEvent", {}, 0)
end function

'----------------------------------------------------------------
' Given: a RumAgent
'  When: set the addResources field with a malformed event (no resource)
'  Then: skips the malformed event but still dispatches the valid one
'----------------------------------------------------------------
function RumAgentTest__WhenAddResourcesHasMalformedEvent_ThenSkipIt() as string
    ' Given
    malformedEvent = { eventType: "addResource" }
    validEvent = { eventType: "addResource", resource: { url: IG_GetString(128) } }

    ' When
    m.testedNode.addResources = [malformedEvent, validEvent]
    sleep(30)

    ' Then: the valid event is dispatched and it is the only handleEvent call
    ' (asserting the valid call first consumes it, so the {} check that follows
    ' confirms nothing else, e.g. the malformed event, was forwarded)
    result = m.mockRumScope@.assertFunctionCalled("handleEvent", { event: validEvent, writer: m.mockWriter }, 1)
    result += m.mockRumScope@.assertFunctionCalled("handleEvent", {}, 0)
    return result
end function

