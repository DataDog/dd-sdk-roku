'----------------------------------------------------------------
' Given: a RumAgent
'  When: call the startOperation method
'  Then: delegates to the root RumScope
'----------------------------------------------------------------
function RumAgentTest__WhenStartOperation_ThenDelegateToRumScope() as string
    ' Given
    fakeName = IG_GetString(32)
    fakeKey = IG_GetString(32)

    ' When
    timestampBefore& = datadogroku_getTimestamp()
    m.testedNode@.startOperation(fakeName, fakeKey)
    timestampAfter& = datadogroku_getTimestamp()
    sleep(30)

    ' Then
    calls = m.mockRumScope@.captureFunctionCalls("handleEvent", { event: { eventType: "startFeatureOperation" } })
    Assert.that(calls).isNotInvalid().hasSize(1)
    capturedEvent = calls[0].event
    Assert.that(capturedEvent.name).isEqualTo(fakeName)
    Assert.that(capturedEvent.operationKey).isEqualTo(fakeKey)
    Assert.that(capturedEvent.vitalId).isNotEmpty()
    Assert.that(capturedEvent.timestamp).isInRange(timestampBefore&, timestampAfter& + 5)
    Assert.that(capturedEvent.context).isEqualTo({})
    Assert.that(calls[0].writer).hasSubtype("MockWriterTask")
    return ""
end function

'----------------------------------------------------------------
' Given: a RumAgent
'  When: call the startOperation method with context
'  Then: delegates to the root RumScope
'----------------------------------------------------------------
function RumAgentTest__WhenStartOperationWithContext_ThenDelegateToRumScope() as string
    ' Given
    fakeName = IG_GetString(32)
    fakeKey = IG_GetString(32)
    fakeContext = {}
    for i = 1 to 5
        fakeContext[IG_GetString(16) + i.toStr()] = IG_GetOneOf([IG_GetString(12), IG_GetInteger(), IG_GetFloat(), IG_GetBoolean()])
    end for

    ' When
    m.testedNode@.startOperation(fakeName, fakeKey, fakeContext)
    sleep(30)

    ' Then
    calls = m.mockRumScope@.captureFunctionCalls("handleEvent", { event: { eventType: "startFeatureOperation" } })
    Assert.that(calls).isNotInvalid().hasSize(1)
    capturedEvent = calls[0].event
    Assert.that(capturedEvent.name).isEqualTo(fakeName)
    Assert.that(capturedEvent.operationKey).isEqualTo(fakeKey)
    Assert.that(capturedEvent.vitalId).isNotEmpty()
    Assert.that(capturedEvent.context).isEqualTo(fakeContext)
    Assert.that(calls[0].writer).hasSubtype("MockWriterTask")
    return ""
end function

'----------------------------------------------------------------
' Given: a RumAgent
