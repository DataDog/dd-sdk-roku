'----------------------------------------------------------------
' Main setup function.
' @return (object) a configured TestSuite object.
'----------------------------------------------------------------
function TestSuite__RumAgent() as object
    this = BaseTestSuite()
    this.Name = "RumAgent"

    this.addTest("WhenStartView_ThenDelegateToRumScope", RumAgentTest__WhenStartView_ThenDelegateToRumScope, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenStartViewWithContext_ThenDelegateToRumScope", RumAgentTest__WhenStartViewWithContext_ThenDelegateToRumScope, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenStopView_ThenDelegateToRumScope", RumAgentTest__WhenStopView_ThenDelegateToRumScope, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenStopView_AfterUploaderTrackTypeChanged_UploaderTrackTypeRestoredToRum", RumAgentTest__WhenStopView_AfterUploaderTrackTypeChanged_UploaderTrackTypeRestoredToRum, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenStopViewWithContext_ThenDelegateToRumScope", RumAgentTest__WhenStopViewWithContext_ThenDelegateToRumScope, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenAddAction_ThenDelegateToRumScope", RumAgentTest__WhenAddAction_ThenDelegateToRumScope, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenAddActionWithContext_ThenDelegateToRumScope", RumAgentTest__WhenAddActionWithContext_ThenDelegateToRumScope, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenAddError_ThenDelegateToRumScope", RumAgentTest__WhenAddError_ThenDelegateToRumScope, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenAddErrorWithContext_ThenDelegateToRumScope", RumAgentTest__WhenAddErrorWithContext_ThenDelegateToRumScope, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenAddResource_ThenDelegateToRumScope", RumAgentTest__WhenAddResource_ThenDelegateToRumScope, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenAddResourceWithContext_ThenDelegateToRumScope", RumAgentTest__WhenAddResourceWithContext_ThenDelegateToRumScope, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenAddResources_ThenDelegateToRumScope", RumAgentTest__WhenAddResources_ThenDelegateToRumScope, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenAddResourcesIsEmpty_ThenDoNotDispatch", RumAgentTest__WhenAddResourcesIsEmpty_ThenDoNotDispatch, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenAddResourcesHasMalformedEvent_ThenSkipIt", RumAgentTest__WhenAddResourcesHasMalformedEvent_ThenSkipIt, RumAgentTest__SetUp, RumAgentTest__TearDown)

    this.addTest("WhenAddConfigTelemetry_ThenDelegateToTelemetryScope", RumAgentTest__WhenAddConfigTelemetry_ThenDelegateToTelemetryScope, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenAddErrorTelemetry_ThenDelegateToTelemetryScope", RumAgentTest__WhenAddErrorTelemetry_ThenDelegateToTelemetryScope, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenAddDebugTelemetry_ThenDelegateToTelemetryScope", RumAgentTest__WhenAddDebugTelemetry_ThenDelegateToTelemetryScope, RumAgentTest__SetUp, RumAgentTest__TearDown)

    ' Operation API dispatch tests
    this.addTest("WhenStartOperation_ThenDelegateToRumScope", RumAgentTest__WhenStartOperation_ThenDelegateToRumScope, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenStartOperationWithContext_ThenDelegateToRumScope", RumAgentTest__WhenStartOperationWithContext_ThenDelegateToRumScope, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenSucceedOperation_ThenDelegateToRumScope", RumAgentTest__WhenSucceedOperation_ThenDelegateToRumScope, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenSucceedOperationWithContext_ThenDelegateToRumScope", RumAgentTest__WhenSucceedOperationWithContext_ThenDelegateToRumScope, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenFailOperation_ThenDelegateToRumScope", RumAgentTest__WhenFailOperation_ThenDelegateToRumScope, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenFailOperationWithContext_ThenDelegateToRumScope", RumAgentTest__WhenFailOperationWithContext_ThenDelegateToRumScope, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenReportOperations_ThenDelegateToRumScope", RumAgentTest__WhenReportOperations_ThenDelegateToRumScope, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenReportOperationsIsEmpty_ThenDoNotDispatch", RumAgentTest__WhenReportOperationsIsEmpty_ThenDoNotDispatch, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenReportOperationsHasInvalidKey_ThenSkipIt", RumAgentTest__WhenReportOperationsHasInvalidKey_ThenSkipIt, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenReportOperationsHasDisallowedCharacterInName_ThenDispatchWithWarning", RumAgentTest__WhenReportOperationsHasDisallowedCharacterInName_ThenDispatchWithWarning, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenReportOperationsHasBlankOperationKey_ThenDispatchWithWarning", RumAgentTest__WhenReportOperationsHasBlankOperationKey_ThenDispatchWithWarning, RumAgentTest__SetUp, RumAgentTest__TearDown)

    ' Operation input validation tests
    this.addTest("WhenStartOperationWithBlankName_ThenDoNotDispatch", RumAgentTest__WhenStartOperationWithBlankName_ThenDoNotDispatch, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenStartOperationWithWhitespaceName_ThenDoNotDispatch", RumAgentTest__WhenStartOperationWithWhitespaceName_ThenDoNotDispatch, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenStartOperationWithDisallowedCharacterInName_ThenDispatchWithWarning", RumAgentTest__WhenStartOperationWithDisallowedCharacterInName_ThenDispatchWithWarning, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenSucceedOperationWithDisallowedCharacterInName_ThenDispatchWithWarning", RumAgentTest__WhenSucceedOperationWithDisallowedCharacterInName_ThenDispatchWithWarning, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenFailOperationWithDisallowedCharacterInName_ThenDispatchWithWarning", RumAgentTest__WhenFailOperationWithDisallowedCharacterInName_ThenDispatchWithWarning, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenStartOperationWithAllowedSchemaCharacters_ThenDispatch", RumAgentTest__WhenStartOperationWithAllowedSchemaCharacters_ThenDispatch, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenStartOperationWithSpacedOperationKey_ThenDispatch", RumAgentTest__WhenStartOperationWithSpacedOperationKey_ThenDispatch, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenStartOperationWithNilKey_ThenDispatch", RumAgentTest__WhenStartOperationWithNilKey_ThenDispatch, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenStartOperationWithBlankKey_ThenDispatchWithWarning", RumAgentTest__WhenStartOperationWithBlankKey_ThenDispatchWithWarning, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenStartOperationWithWhitespaceKey_ThenDispatchWithWarning", RumAgentTest__WhenStartOperationWithWhitespaceKey_ThenDispatchWithWarning, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenStartOperationWithNonStringKey_ThenDoNotDispatch", RumAgentTest__WhenStartOperationWithNonStringKey_ThenDoNotDispatch, RumAgentTest__SetUp, RumAgentTest__TearDown)
    this.addTest("WhenFailOperationWithInvalidReason_ThenDoNotDispatch", RumAgentTest__WhenFailOperationWithInvalidReason_ThenDoNotDispatch, RumAgentTest__SetUp, RumAgentTest__TearDown)

    return this
end function

sub RumAgentTest__SetUp()
    ' Mocks
    m.testSuite.mockUploader = CreateObject("roSGNode", "MockUploaderTask")
    m.testSuite.mockWriter = CreateObject("roSGNode", "MockWriterTask")
    m.testSuite.mockRumScope = CreateObject("roSGNode", "MockRumScope")
    m.testSuite.mockTelemetryScope = CreateObject("roSGNode", "MockRumScope")

    ' Fake data
    m.testSuite.fakeDeviceModel = IG_GetString(16)
    m.testSuite.fakeDeviceName = IG_GetString(16)
    m.testSuite.fakeOsVersion = IG_GetString(16)
    m.testSuite.fakeOsVersionMajor = IG_GetString(16)
    m.testSuite.fakeEnv = IG_GetString(10)
    m.testSuite.fakeSite = IG_GetString(3)
    m.testSuite.fakeApplicationId = IG_GetString(32)
    m.testSuite.fakeService = IG_GetString(32)
    m.testSuite.fakeVersion = IG_GetString(32)
    m.testSuite.fakeKeepAliveDelayMs = 10 + IG_GetInteger(30)

    ' Tested Task
    m.testSuite.testedNode = CreateObject("roSGNode", "datadogroku_RumAgent")
    m.testSuite.testedNode.uploader = m.testSuite.mockUploader
    m.testSuite.testedNode.writer = m.testSuite.mockWriter
    m.testSuite.testedNode.rumScope = m.testSuite.mockRumScope
    m.testSuite.testedNode.telemetryScope = m.testSuite.mockTelemetryScope
    m.testSuite.testedNode.keepAliveDelayMs = m.testSuite.fakeKeepAliveDelayMs
    m.testSuite.testedNode.site = m.testSuite.fakeSite
    m.testSuite.testedNode.env = m.testSuite.fakeEnv
    m.testSuite.testedNode.applicationId = m.testSuite.fakeApplicationId
    m.testSuite.testedNode.service = m.testSuite.fakeService
    m.testSuite.testedNode.version = m.testSuite.fakeVersion
    m.testSuite.testedNode.deviceName = m.testSuite.fakeDeviceName
    m.testSuite.testedNode.deviceModel = m.testSuite.fakeDeviceModel
    m.testSuite.testedNode.osVersion = m.testSuite.fakeOsVersion
    m.testSuite.testedNode.osVersionMajor = m.testSuite.fakeOsVersionMajor
    m.testSuite.testedNode.control = "RUN"
    ' Allow the RumAgent task to process DI messages (uploader, writer, rumScope, etc.)
    ' so m.rumScope is set before tests call addAction/startView/etc.
    sleep(100)
end sub

sub RumAgentTest__SetUpNoMock()

    ' Fake data
    m.testSuite.fakeDeviceModel = IG_GetString(16)
    m.testSuite.fakeDeviceName = IG_GetString(16)
    m.testSuite.fakeOsVersion = IG_GetString(16)
    m.testSuite.fakeOsVersionMajor = IG_GetString(16)
    m.testSuite.fakeSite = IG_GetOneOf(["us1", "us3", "us5", "eu1"])
    m.testSuite.fakeApplicationId = IG_GetString(32)
    m.testSuite.fakeService = IG_GetString(32)
    m.testSuite.fakeKeepAliveDelayMs = 10 + IG_GetInteger(30)
    m.testSuite.fakeEnv = IG_GetString(10)
    m.testSuite.fakeVersion = IG_GetString(32)

    ' Tested Task
    m.testSuite.testedNode = CreateObject("roSGNode", "datadogroku_RumAgent")
    m.testSuite.testedNode.keepAliveDelayMs = m.testSuite.fakeKeepAliveDelayMs
    m.testSuite.testedNode.site = m.testSuite.fakeSite
    m.testSuite.testedNode.applicationId = m.testSuite.fakeApplicationId
    m.testSuite.testedNode.service = m.testSuite.fakeService
    m.testSuite.testedNode.version = m.testSuite.fakeVersion
    m.testSuite.testedNode.deviceName = m.testSuite.fakeDeviceName
    m.testSuite.testedNode.deviceModel = m.testSuite.fakeDeviceModel
    m.testSuite.testedNode.osVersion = m.testSuite.fakeOsVersion
    m.testSuite.testedNode.osVersionMajor = m.testSuite.fakeOsVersionMajor
    m.testSuite.testedNode.env = m.testSuite.fakeEnv
    m.testSuite.testedNode.control = "RUN"
    ' Allow the RumAgent task to process DI messages (uploader, writer, rumScope, etc.)
    ' so m.rumScope is set before tests call addAction/startView/etc.
    sleep(100)
end sub

sub RumAgentTest__TearDown()
    m.testSuite.testedNode.control = "STOP"
    if(m.testSuite.testedNode.writer <> invalid) 
        m.testSuite.testedNode.writer.control = "STOP"
    end if
    if(m.testSuite.testedNode.uploader <> invalid)
        m.testSuite.testedNode.uploader.control = "STOP"
    end if
    m.testSuite.testedNode.Delete("uploader")
    m.testSuite.testedNode.Delete("writer")
    m.testSuite.Delete("mockUploader")
    m.testSuite.Delete("mockWriter")
    m.testSuite.Delete("mockRumScope")
    m.testSuite.Delete("testedNode")
end sub

'----------------------------------------------------------------
' Given: a RumAgent
'  When: call the startView method
'  Then: delegates to the root RumScope
'----------------------------------------------------------------
function RumAgentTest__WhenStartView_ThenDelegateToRumScope() as string
    ' Given
    fakeViewName = IG_GetString(32)
    fakeViewUrl = IG_GetString(32)

    ' When
    m.testedNode@.startView(fakeViewName, fakeViewUrl)
    sleep(30)

    ' Then
    expectedArgs = { event: { eventType: "startView", viewName: fakeViewName, viewUrl: fakeViewUrl }, writer: m.mockWriter }
    return m.testedNode.rumScope@.assertFunctionCalled("handleEvent", expectedArgs)
end function

'----------------------------------------------------------------
' Given: a RumAgent
'  When: call the startView method with context
'  Then: delegates to the root RumScope
'----------------------------------------------------------------
function RumAgentTest__WhenStartViewWithContext_ThenDelegateToRumScope() as string
    ' Given
    fakeViewName = IG_GetString(32)
    fakeViewUrl = IG_GetString(32)
    fakeContext = {}
    for i = 1 to 5
        fakeContext[IG_GetString(16) + i.toStr()] = IG_GetOneOf([IG_GetString(12), IG_GetInteger(), IG_GetFloat(), IG_GetBoolean()])
    end for

    ' When
    m.testedNode.writer = m.mockWriter
    m.testedNode@.startView(fakeViewName, fakeViewUrl, fakeContext)
    sleep(30)

    ' Then
    expectedArgs = { event: { eventType: "startView", viewName: fakeViewName, viewUrl: fakeViewUrl, context: fakeContext }, writer: m.mockWriter }
    return m.mockRumScope@.assertFunctionCalled("handleEvent", expectedArgs)
end function

