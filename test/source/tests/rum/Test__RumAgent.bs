'----------------------------------------------------------------
' Given: a RumAgent
'  When: set the reportOperations field with an array of pre-built operation events
'  Then: delegates each event to the root RumScope
'----------------------------------------------------------------
function RumAgentTest__WhenReportOperations_ThenDelegateToRumScope() as string
    ' Given
    fakeEvent1 = { eventType: "startFeatureOperation", name: IG_GetString(32) }
    fakeEvent2 = { eventType: "stopFeatureOperation", name: IG_GetString(32) }

    ' When
    m.testedNode.reportOperations = [fakeEvent1, fakeEvent2]
    sleep(30)

    ' Then
    result = m.mockRumScope@.assertFunctionCalled("handleEvent", { event: fakeEvent1, writer: m.mockWriter })
    result += m.mockRumScope@.assertFunctionCalled("handleEvent", { event: fakeEvent2, writer: m.mockWriter })
    return result
end function

'----------------------------------------------------------------
' Given: a RumAgent
'  When: set the reportOperations field with an empty array
'  Then: dispatches nothing to the root RumScope
'----------------------------------------------------------------
function RumAgentTest__WhenReportOperationsIsEmpty_ThenDoNotDispatch() as string
    ' When
    m.testedNode.reportOperations = []
    sleep(30)

    ' Then
    return m.mockRumScope@.assertFunctionCalled("handleEvent", {}, 0)
end function

'----------------------------------------------------------------
' Given: a RumAgent
'  When: set the reportOperations field with an event carrying an invalid
'        (non-string) operationKey
'  Then: skips the invalid event but still dispatches the valid one
'----------------------------------------------------------------
function RumAgentTest__WhenReportOperationsHasInvalidKey_ThenSkipIt() as string
    ' Given
    invalidEvent = { eventType: "startFeatureOperation", name: IG_GetString(32), operationKey: 1 }
    validEvent = { eventType: "startFeatureOperation", name: IG_GetString(32) }

    ' When
    m.testedNode.reportOperations = [invalidEvent, validEvent]
    sleep(30)

    ' Then: the valid event is dispatched and it is the only handleEvent call
    ' (asserting the valid call first consumes it, so the {} check that follows
    ' confirms nothing else, e.g. the invalid event, was forwarded)
    result = m.mockRumScope@.assertFunctionCalled("handleEvent", { event: validEvent, writer: m.mockWriter }, 1)
    result += m.mockRumScope@.assertFunctionCalled("handleEvent", {}, 0)
    return result
end function

'----------------------------------------------------------------
' Given: a RumAgent
'  When: set the reportOperations field with a pre-built event whose name
'        contains characters outside the schema facet-path character set
'  Then: dispatch the event anyway — see startOperation's disallowed-
'        character test for the rationale. The agent still logs a WARNING
'        to flag the suspicious name.
'----------------------------------------------------------------
function RumAgentTest__WhenReportOperationsHasDisallowedCharacterInName_ThenDispatchWithWarning() as string
    ' Given
    invalidNameEvent = { eventType: "startFeatureOperation", name: "user login" }

    ' When
    m.testedNode.reportOperations = [invalidNameEvent]
    sleep(30)

    ' Then
    return m.mockRumScope@.assertFunctionCalled("handleEvent", { event: invalidNameEvent, writer: m.mockWriter }, 1)
end function

'----------------------------------------------------------------
' Given: a RumAgent
'  When: set the reportOperations field with a pre-built event whose
'        operationKey is blank/whitespace-only
'  Then: dispatch the event anyway — operationKey is optional, so a
'        malformed value is never grounds to drop the step. The agent
'        still logs a WARNING to flag the suspicious key.
'----------------------------------------------------------------
function RumAgentTest__WhenReportOperationsHasBlankOperationKey_ThenDispatchWithWarning() as string
    ' Given
    blankKeyEvent = { eventType: "startFeatureOperation", name: IG_GetString(32), operationKey: "   " }

    ' When
    m.testedNode.reportOperations = [blankKeyEvent]
    sleep(30)

    ' Then
    return m.mockRumScope@.assertFunctionCalled("handleEvent", { event: blankKeyEvent, writer: m.mockWriter }, 1)
end function

'----------------------------------------------------------------
' Given: a RumAgent
'  When: call the failOperation method with a name containing
'        characters outside the schema facet-path character set
'        (letters / digits / - _ . @ $)
'  Then: dispatch the event anyway — see startOperation's disallowed-
'        character test for the rationale. The agent still logs a
