function TestSuite__WriterTask() as object
    this = BaseTestSuite()
    this.Name = "WriterTask"
    this.addTest("WhenRepeatedEvents_ThenWriteDistinctVerifiedRecords", WriterTaskTest__Repeated, WriterTaskTest__SetUp, WriterTaskTest__TearDown)
    this.addTest("WhenExistingFiles_ThenPreserveTheirBytes", WriterTaskTest__Existing, WriterTaskTest__SetUp, WriterTaskTest__TearDown)
    this.addTest("WhenUnicodeAndOversized_ThenKeepExactPayload", WriterTaskTest__Unicode, WriterTaskTest__SetUp, WriterTaskTest__TearDown)
    this.addTest("WhenEmptyEvent_ThenSkipIt", WriterTaskTest__Empty, WriterTaskTest__SetUp, WriterTaskTest__TearDown)
    this.addTest("WhenRestarted_ThenPreserveEarlierRecords", WriterTaskTest__Restart, WriterTaskTest__SetUp, WriterTaskTest__TearDown)
    this.waitForRecords = WriterTaskTest__WaitForRecords
    return this
end function

sub WriterTaskTest__SetUp()
    m.testSuite.trackType = "writer_" + CreateObject("roDeviceInfo").GetRandomUUID()
    m.testSuite.folderPath = datadogroku_trackFolderPath(m.testSuite.trackType)
    m.testSuite.scope = ImmutableRecordsTest__Scope()
    m.testSuite.testedTask = WriterTaskTest__NewWriter(m.testSuite.trackType, m.testSuite.scope)
end sub

function WriterTaskTest__NewWriter(trackType as string, scope as string) as object
    writer = CreateObject("roSGNode", "datadogroku_WriterTask")
    writer.setFields({ trackType: trackType, storageScope: scope })
    return writer
end function

sub WriterTaskTest__TearDown()
    m.testSuite.testedTask.control = "STOP"
    CreateObject("roFileSystem").Delete(m.testSuite.folderPath)
end sub

function WriterTaskTest__WaitForRecords(count as integer) as object
    timer = CreateObject("roTimespan")
    records = []
    while (timer.TotalMilliseconds() < 5000)
        records = []
        for each filename in ListDir(m.folderPath)
            record = datadogroku_readImmutableRecord(m.folderPath, filename, m.scope)
            if (record <> invalid)
                records.Push(record)
            end if
        end for
        if (records.Count() >= count)
            return records
        end if
        sleep(10)
    end while
    Assert.that(false).isTrue("Timed out waiting for verified writer records")
    return records
end function

function WriterTaskTest__Repeated() as string
    for i = 1 to 3
        m.testedTask.writeEvent = "same event"
    end for
    records = m.waitForRecords(3)
    Assert.that(records).hasSize(3)
    for each record in records
        Assert.that(record.payload).isEqualTo("same event")
    end for
    return ""
end function

function WriterTaskTest__Existing() as string
    datadogroku_mkDirs(m.folderPath)
    names = ["0", "9999999999999", "_last_view_test", "unknown", "_dd2_partial"]
    for each filename in names
        WriteAsciiFile(m.folderPath + "/" + filename, "preserve " + filename)
    end for
    m.testedTask.writeEvent = "new event"
    records = m.waitForRecords(1)
    Assert.that(records[0].payload).isEqualTo("new event")
    for each filename in names
        Assert.that(ReadAsciiFile(m.folderPath + "/" + filename)).isEqualTo("preserve " + filename)
    end for
    Assert.that(ListDir(m.folderPath)).hasSize(6)
    return ""
end function

function WriterTaskTest__Unicode() as string
    payload = "café " + Chr(128512)
    while (payload.Len() < 20000)
        payload += payload
    end while
    m.testedTask.writeEvent = payload
    records = m.waitForRecords(1)
    Assert.that(records[0].payload).isEqualTo(payload)
    bytes = CreateObject("roByteArray")
    bytes.FromAsciiString(payload)
    Assert.that(records[0].byteCount).isEqualTo(bytes.Count())
    return ""
end function

function WriterTaskTest__Empty() as string
    ' A later nonempty event acts as the queue barrier; no timing-only assertion.
    m.testedTask.writeEvent = ""
    m.testedTask.writeEvent = "after empty"
    records = m.waitForRecords(1)
    Assert.that(records).hasSize(1)
    Assert.that(records[0].payload).isEqualTo("after empty")
    return ""
end function

function WriterTaskTest__Restart() as string
    m.testedTask.writeEvent = "before restart"
    first = m.waitForRecords(1)[0]
    m.testedTask.control = "STOP"
    m.testedTask = WriterTaskTest__NewWriter(m.trackType, m.scope)
    m.testedTask.writeEvent = "after restart"
    records = m.waitForRecords(2)
    Assert.that(records).hasSize(2)
    Assert.that(ReadAsciiFile(m.folderPath + "/" + first.filename)).isEqualTo("before restart")
    return ""
end function
