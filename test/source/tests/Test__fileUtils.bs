'----------------------------------------------------------------
' Main setup function.
' @return A configured TestSuite object.
'----------------------------------------------------------------
function TestSuite__FileUtils() as object
    this = BaseTestSuite()
    this.Name = "FileUtils"

    this.addTest("WhenMkDirs_ThenCreateDir", FileUtilsTest__WhenMkDirs_ThenCreateDir)
    this.addTest("WhenMkDirsExisting_ThenDoNothing", FileUtilsTest__WhenMkDirsExisting_ThenDoNothing)
    this.addTest("WhenMkDirs_ThenCreateParentDirs", FileUtilsTest__WhenMkDirs_ThenCreateParentDirs)
    this.addTest("WhenMkDirsInvalidPath_ThenDoNothing", FileUtilsTest__WhenMkDirsInvalidPath_ThenDoNothing)

    this.addTest("WhenTrackFolderPath_ThenComputePath", FileUtilsTest__WhenTrackFolderPath_ThenComputePath)

    this.addTest("WhenAppendAsciiFile_ThenAppendsToExistingFile", FileUtilsTest__WhenAppendAsciiFile_ThenAppendsToExistingFile)
    this.addTest("WhenAppendAsciiFile_ThenAppendsToEmptyFile", FileUtilsTest__WhenAppendAsciiFile_ThenAppendsToEmptyFile)

    this.addTest("WhenDeleteFileMissing_ThenCleanupComplete", FileUtilsTest__WhenDeleteFileMissing_ThenCleanupComplete)
    this.addTest("WhenDeleteFileExists_ThenRemoveOnlyThatFile", FileUtilsTest__WhenDeleteFileExists_ThenRemoveOnlyThatFile)
    this.addTest("WhenDeleteFileReadOnly_ThenReportFailure", FileUtilsTest__WhenDeleteFileReadOnly_ThenReportFailure)
    this.addTest("WhenDeletePathIsDirectory_ThenPreserveContents", FileUtilsTest__WhenDeletePathIsDirectory_ThenPreserveContents)

    this.addTest("WhenStrToLong_ThenReturnsLong", FileUtilsTest__WhenStrToLong_ThenReturnsLong)
    this.addTest("WhenStrToLongOnString_ThenReturnsLong", FileUtilsTest__WhenStrToLongOnString_ThenReturnsLong)

    this.addTest("WhenParseLegacyBatchTimestamp_ThenValidateWholeName", FileUtilsTest__ParseLegacyBatchTimestamp)

    this.addTest("WhenDirectoryCreationFails_ThenDoNotEnqueueTelemetry", FileUtilsTest__DirectoryFailureDoesNotEnqueueTelemetry)

    return this
end function

function FileUtilsTest__WhenDeleteFileMissing_ThenCleanupComplete() as string
    path = "tmp:/" + CreateObject("roDeviceInfo").GetRandomUUID()
    Assume.that(path).doesNotExist()
    Assert.that(datadogroku_deleteFileIfPresent(path)).isTrue()
    Assert.that(path).doesNotExist()
    return ""
end function

function FileUtilsTest__WhenDeleteFileExists_ThenRemoveOnlyThatFile() as string
    path = "tmp:/" + CreateObject("roDeviceInfo").GetRandomUUID()
    neighbor = path + "-other"
    Assume.that(WriteAsciiFile(path, "batch")).isTrue()
    Assume.that(WriteAsciiFile(neighbor, "keep")).isTrue()
    Assert.that(datadogroku_deleteFileIfPresent(path)).isTrue()
    Assert.that(path).doesNotExist()
    Assert.that(ReadAsciiFile(neighbor)).isEqualTo("keep")
    ' A second cleanup of the same path is also complete.
    Assert.that(datadogroku_deleteFileIfPresent(path)).isTrue()
    DeleteFile(neighbor)
    return ""
end function

function FileUtilsTest__WhenDeleteFileReadOnly_ThenReportFailure() as string
    ' pkg is read-only: this must remain a real cleanup failure, not success.
    path = "pkg:/manifest"
    before = ReadAsciiFile(path)
    Assume.that(path).exists()
    Assert.that(datadogroku_deleteFileIfPresent(path)).isFalse()
    Assert.that(ReadAsciiFile(path)).isEqualTo(before)
    return ""
end function

function FileUtilsTest__WhenDeletePathIsDirectory_ThenPreserveContents() as string
    path = "tmp:/" + CreateObject("roDeviceInfo").GetRandomUUID()
    Assume.that(CreateDirectory(path)).isTrue()
    child = path + "/keep"
    Assume.that(WriteAsciiFile(child, "keep")).isTrue()
    Assert.that(datadogroku_deleteFileIfPresent(path)).isFalse()
    Assert.that(ReadAsciiFile(child)).isEqualTo("keep")
    DeleteFile(child)
    DeleteDirectory(path)
    return ""
end function

'----------------------------------------------------------------
' Checks that mkDirs creates the required directory
'----------------------------------------------------------------
function FileUtilsTest__WhenMkDirs_ThenCreateDir() as string
    ' Given
    path = IG_GetOneOf(["cachefs", "tmp"]) + ":/" + IG_GetString(16)
    Assume.that(path).doesNotExist()

    ' When
    result = datadogroku_mkDirs(path)

    ' Then
    Assert.that(result).isTrue("Expected result to be true")
    Assert.that(path).exists()
    return ""
end function

'----------------------------------------------------------------
' Checks that mkDirs does nothing if folder already exists
'----------------------------------------------------------------
function FileUtilsTest__WhenMkDirsExisting_ThenDoNothing() as string
    ' Given
    path = IG_GetOneOf(["cachefs", "tmp"]) + ":/" + IG_GetString(16)
    Assume.that(path).doesNotExist()

    ' When
    result = datadogroku_mkDirs(path)
    result2 = datadogroku_mkDirs(path)

    ' Then
    Assert.that(result).isTrue("Expected result to be true")
    Assert.that(result2).isTrue("Expected result2 to be true")
    Assert.that(path).exists()
    return ""
end function

'----------------------------------------------------------------
' Checks that mkDirs creates all intermediate directories
'----------------------------------------------------------------
function FileUtilsTest__WhenMkDirs_ThenCreateParentDirs() as string
    ' Given
    folderNames = IG_GetArray(["string", "string", "string", "string"])
    path = IG_GetOneOf(["cachefs", "tmp"]) + ":"
    for each folderName in folderNames
        path = path + "/" + folderName
    end for
    Assume.that(path).doesNotExist()

    ' When
    result = datadogroku_mkDirs(path)

    ' Then
    Assert.that(result).isTrue("Expected result to be true")
    Assert.that(path).exists()
    return ""
end function

'----------------------------------------------------------------
' Checks that mkDirs fails silently when an invalid path is provided
' cf: https://developer.roku.com/en-gb/docs/developer-program/getting-started/architecture/file-system.md
'----------------------------------------------------------------
function FileUtilsTest__WhenMkDirsInvalidPath_ThenDoNothing() as string
    ' Given
    invalidChar = IG_GetOneOf(["<", ">", """", ":", "|", "?", "*"])
    path = IG_GetOneOf(["foo", "bar"]) + ":/" + IG_GetString(8) + invalidChar + IG_GetString(8)
    Assume.that(path).doesNotExist()

    ' When
    result = datadogroku_mkDirs(path)

    ' Then
    Assert.that(result).isFalse("Expected result to be false")
    Assert.that(path).doesNotExist()
    return ""
end function

'----------------------------------------------------------------
' Checks that trackFolderPath creates a relevant path
'----------------------------------------------------------------
function FileUtilsTest__WhenTrackFolderPath_ThenComputePath() as string
    ' Given
    trackType = IG_GetString(8)
    version = IG_GetInteger(64)

    ' When
    result = datadogroku_trackFolderPath(trackType, version)

    ' Then
    Assert.that(result).isEqualTo("cachefs:/datadog/v" + version.toStr() + "/" + trackType)
    return ""
end function

'----------------------------------------------------------------
' Checks that AppendAsciiFile appends data to an existing file
'----------------------------------------------------------------
function FileUtilsTest__WhenAppendAsciiFile_ThenAppendsToExistingFile() as string
    ' Given
    filepath = IG_GetOneOf(["cachefs", "tmp"]) + ":/" + IG_GetString(8)
    initialText = IG_GetString(8)
    appendedText = IG_GetString(8)
    WriteAsciiFile(filepath, initialText)

    ' When
    result = datadogroku_AppendAsciiFile(filepath, appendedText)

    ' Then
    Assert.that(result).isEqualTo(true)
    Assert.that(ReadAsciiFile(filepath)).isEqualTo(initialText + appendedText)
    return ""
end function

'----------------------------------------------------------------
' Checks that AppendAsciiFile writes to an existing empty file
'----------------------------------------------------------------
function FileUtilsTest__WhenAppendAsciiFile_ThenAppendsToEmptyFile() as string
    ' Given
    filepath = IG_GetOneOf(["cachefs", "tmp"]) + ":/" + IG_GetString(8)
    appendedText = IG_GetString(8)
    WriteAsciiFile(filepath, "")

    ' When
    result = datadogroku_AppendAsciiFile(filepath, appendedText)

    ' Then

    Assert.that(result).isEqualTo(true)
    Assert.that(ReadAsciiFile(filepath)).isEqualTo(appendedText)
    return ""
end function

'----------------------------------------------------------------
' Checks that AppendAsciiFile creates and writes to a non-existing file
'----------------------------------------------------------------
function FileUtilsTest__WhenAppendAsciiFile_ThenCreateNewFile() as string
    ' Given
    filepath = IG_GetOneOf(["cachefs", "tmp"]) + ":/" + IG_GetString(8)
    appendedText = IG_GetString(8)

    ' When
    result = datadogroku_AppendAsciiFile(filepath, appendedText)

    ' Then
    Assert.that(result).isEqualTo(true)
    Assert.that(ReadAsciiFile(filepath)).isEqualTo(appendedText)
    return ""
end function

'----------------------------------------------------------------
' Checks that strToLong parses long properly
'----------------------------------------------------------------
function FileUtilsTest__WhenStrToLong_ThenReturnsLong() as string
    for i = 0 to 100
        ' Given
        input& = IG_GetLongInteger()
        input$ = input&.toStr()

        ' When
        result& = datadogroku_strToLong(input$)

        ' Then
        Assert.that(result&).isEqualTo(input&)
    end for
    return ""
end function

'----------------------------------------------------------------
' Checks that strToLong parses not long safely
'----------------------------------------------------------------
function FileUtilsTest__WhenStrToLongOnString_ThenReturnsLong() as string
    for i = 0 to 100
        ' Given
        input$ = IG_GetString(128)

        ' When
        crashed = false
        try
            datadogroku_strToLong(input$)
        catch e
            crashed = true
        end try

        ' Then
        Assert.that(crashed).isFalse()
    end for
    return ""
end function

function FileUtilsTest__ParseLegacyBatchTimestamp() as string
    Assert.that(datadogroku_parseLegacyBatchTimestamp("0001")).isEqualTo(1&)
    Assert.that(datadogroku_parseLegacyBatchTimestamp("1760000000000")).isEqualTo(1760000000000&)
    maximum& = datadogroku_parseLegacyBatchTimestamp("9223372036854745807")
    Assert.that(maximum& + 30000&).isEqualTo(9223372036854775807&)
    for each filename in ["0", "1", "0001", "1760000000000", "9223372036854745807"]
        parsed = datadogroku_parseLegacyBatchTimestamp(filename)
        Assert.that(parsed).isNotInvalid()
        Assert.that(parsed).isEqualTo(datadogroku_strToLong(filename))
    end for
    for each filename in ["", "-1", "+1", "1.0", "1e3", " 1", "1 ", "1x", "x1", "_last_view_1", "_batch_1", "1/2", "9223372036854745808", "9223372036854775807", "10000000000000000000"]
        Assert.that(datadogroku_parseLegacyBatchTimestamp(filename)).isInvalid(filename)
    end for
    return ""
end function

function FileUtilsTest__DirectoryFailureDoesNotEnqueueTelemetry() as string
    agent = CreateObject("roSGNode", "TestDirectoryErrorAgent")
    fakeGlobal = CreateObject("roSGNode", "Node")
    fakeGlobal.addFields({ datadogRumAgent: agent })
    ' Bind the real helper to an isolated context, without changing app globals.
    context = { global: fakeGlobal, makeDirectory: datadogroku_mkDirs }
    readOnlyPath = "pkg:/directory_failure_" + CreateObject("roDeviceInfo").GetRandomUUID()
    for each path in ["invalid:/<>invalid", readOnlyPath]
        for i = 1 to 10
            Assert.that(context.makeDirectory(path)).isFalse()
            Assert.that(path).doesNotExist()
        end for
    end for
    return agent@.assertFunctionCalled("addErrorTelemetry", {}, 0)
end function
