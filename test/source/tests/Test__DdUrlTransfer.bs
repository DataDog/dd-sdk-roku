    ddUrlTransfer = datadogroku_DdUrlTransfer(fakeGlobal)
    ddUrlTransfer.SetUrl("https://datadog.com")
    ddUrlTransfer._traceRequest()
    result = ddUrlTransfer.GetHeader("x-datadog-sampling-priority")
