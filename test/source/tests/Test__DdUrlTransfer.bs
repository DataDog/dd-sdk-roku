            traceSampleRate: 0,
            tracingHeaderTypes: [
                {
                    "host": "datadog.com",
                    "header": "datadog"
                }
            ],
            traceContextInjection: "all"
        },
        datadogUserInfo:  { id: fakeId, name: fakeName, email: fakeEmail}
    }
    ddUrlTransfer = datadogroku_DdUrlTransfer(fakeGlobal)
    ddUrlTransfer.SetUrl("https://datadog.com")
    ddUrlTransfer._traceRequest()
    result = ddUrlTransfer.GetHeader("x-datadog-sampling-priority")
    Assert.that(result[0]).isEqualTo("0")
    return ""
end function

