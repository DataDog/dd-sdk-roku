' Mirrors MultiTrackUploaderTask's registerTrack merge so agents' registrations land in `tracks`.
sub onRegisterTrack()
    registration = m.top.registerTrack
    if (registration = invalid or registration.id = invalid or registration.info = invalid)
        return
    end if
    tracks = m.top.tracks ?? {}
    tracks[registration.id] = registration.info
    m.top.tracks = tracks
end sub
