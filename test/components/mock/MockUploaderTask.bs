sub registerTrack(trackId as string, trackInfo as object)
    recordFunctionCall("registerTrack", { trackId: trackId, trackInfo: trackInfo })
    tracks = m.top.tracks ?? {}
    tracks[trackId] = trackInfo
    m.top.tracks = tracks
end sub
