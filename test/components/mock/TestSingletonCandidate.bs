sub init()
    m.top.functionName = "holdOwnership"
end sub

sub holdOwnership()
    m.top.started = true
    ' Remain active until teardown stops us. No network or filesystem operations.
    port = CreateObject("roMessagePort")
    wait(0, port)
end sub
