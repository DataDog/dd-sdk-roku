sub configureFailure(failWrite as integer)
    m.crashRecordIO = {
        delegate: datadogroku_newImmutableRecordIO(),
        failWrite: failWrite,
        writes: 0,
        exists: function(path as string) as boolean
            return m.delegate.exists(path)
        end function,
        read: function(path as string, byteCount as integer) as dynamic
            return m.delegate.read(path, byteCount)
        end function,
        write: function(path as string, bytes as object) as boolean
            m.writes++
            if (m.writes = m.failWrite)
                return false
            end if
            return m.delegate.write(path, bytes)
        end function
    }
end sub

sub configureSnapshotCleanupFailure(_unused as dynamic)
    m.snapshotIO = datadogroku_newViewSnapshotIO()
    m.snapshotIO.remove = function(_path as string) as boolean
        return false
    end function
end sub
