sub init()
    m.top.functionName = "registerAfterBarrier"
end sub

sub registerAfterBarrier()
    try
        gate = m.top.gate
        port = CreateObject("roMessagePort")
        gate.observeFieldScoped("released", port)
        m.top.ready = true
        if (not gate.released)
            wait(15000, port)
        end if
        if (not gate.released)
            m.top.failure = "Timed out waiting for registration barrier"
        else
            m.top.uploader@.registerTrack(m.top.trackId, m.top.trackInfo)
        end if
    catch error
        m.top.failure = error.message
    end try
    m.top.done = true
end sub
