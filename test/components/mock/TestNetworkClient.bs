' Exercise the inherited production method with real file reads and no network.
function postWithFakeTransport(filePath as string, prefix as string, postfix as string, responseCode as integer) as object
    m.urlTransfer = {
        postCount: 0,
        body: invalid,
        responseCode: responseCode,
        SetUrl: sub(url as string)
            m.url = url
        end sub,
        SetRequest: sub(method as string)
            m.method = method
        end sub,
        SetCertificatesFile: function(path as string) as boolean
            m.certificates = path
            return true
        end function,
        SetHeaders: function(headers as object) as boolean
            m.headers = headers
            return true
        end function,
        PostFromString: function(body as string) as integer
            m.postCount++
            m.body = body
            return m.responseCode
        end function
    }
    result = postFromFile("https://example.invalid", filePath, {}, prefix, postfix)
    return { responseCode: result, postCount: m.urlTransfer.postCount, body: m.urlTransfer.body }
end function
