'*****************************************************************
' itemGenerator.bs
' Random test data generators for roca unit tests.
' Ported from Roku UTF ItemGenerator.brs — no UTF dependency.
'*****************************************************************

' ----------------------------------------------------------------
' Generates a random boolean.
' @return (boolean) random true or false.
' ----------------------------------------------------------------
function IG_GetBoolean() as boolean
    return Rnd(2) = 1
end function

' ----------------------------------------------------------------
' Generates a random integer from 1 to seed (inclusive).
' @param seed (integer) upper bound; default 100.
' @return (integer) random integer.
' ----------------------------------------------------------------
function IG_GetInteger(seed = 100 as integer) as integer
    return Rnd(seed)
end function

' ----------------------------------------------------------------
' Generates a random longinteger.
' @return (longinteger) random large integer.
' ----------------------------------------------------------------
function IG_GetLongInteger() as longinteger
    maxInt& = 2147483647
    result& = IG_GetInteger(maxInt&)
    result& *= maxInt&
    result& += IG_GetInteger(maxInt&)
    return result&
end function

' ----------------------------------------------------------------
' Generates a random integer in [min, max].
' @param min (integer) lower bound (inclusive); default 0.
' @param max (integer) upper bound (inclusive); default 100.
' @return (integer) random integer in range.
' ----------------------------------------------------------------
function IG_GetIntegerInRange(min = 0 as integer, max = 100 as integer) as integer
    return Rnd(max - min + 1) + min - 1
end function

' ----------------------------------------------------------------
' Generates a random float in [0, 1).
' @return (float) random float.
' ----------------------------------------------------------------
function IG_GetFloat() as float
    return Rnd(0)
end function

' ----------------------------------------------------------------
' Generates a random double in [0, 1).
' @return (double) random double.
' ----------------------------------------------------------------
function IG_GetDouble() as double
    return Rnd(0)
end function

' ----------------------------------------------------------------
' Generates a random alphanumeric string of up to seed characters.
' @param seed (integer) maximum string length.
' @return (string) random string (may be shorter than seed).
' ----------------------------------------------------------------
function IG_GetString(seed as integer) as string
    item = ""
    if seed > 0
        stringLength = Rnd(seed)
        for i = 1 to stringLength
            chType = Rnd(3)
            if chType = 1
                chNumber = 47 + Rnd(10)   ' 0-9
            else if chType = 2
                chNumber = 64 + Rnd(26)   ' A-Z
            else
                chNumber = 96 + Rnd(26)   ' a-z
            end if
            item = item + Chr(chNumber)
        end for
    end if
    return item
end function

' ----------------------------------------------------------------
' Returns a random element from an array.
' @param data (object) array to pick from.
' @return (dynamic) a random element.
' ----------------------------------------------------------------
function IG_GetOneOf(data as object) as dynamic
    index = Rnd(data.count()) - 1
    return data[index]
end function

' ----------------------------------------------------------------
' Generates an array of random values from a list of type specs.
' Each element of types must be one of: "string", "integer",
' "boolean", "float", "double".
' @param types (object) array of type name strings.
' @return (object) array of random values of the requested types.
' ----------------------------------------------------------------
function IG_GetArray(types as object) as object
    result = []
    for each typeName in types
        if typeName = "string"
            result.Push(IG_GetString(32))
        else if typeName = "integer"
            result.Push(IG_GetInteger())
        else if typeName = "boolean"
            result.Push(IG_GetBoolean())
        else if typeName = "float"
            result.Push(IG_GetFloat())
        else if typeName = "double"
            result.Push(IG_GetDouble())
        else
            result.Push(invalid)
        end if
    end for
    return result
end function

' ----------------------------------------------------------------
' Generates a random backtrace array.
' @return (object) array of backtrace frame objects.
' ----------------------------------------------------------------
function IG_GetBacktrace() as object
    size = IG_GetInteger(32)
    backtrace = []
    for i = 1 to size
        backtrace.Push(IG_GetBacktraceFrame())
    end for
    return backtrace
end function

' ----------------------------------------------------------------
' Generates a random backtrace frame.
' @return (object) backtrace frame with function, filename, line_number.
' ----------------------------------------------------------------
function IG_GetBacktraceFrame() as object
    return {
        function: IG_GetString(32),
        filename: IG_GetString(32),
        line_number: IG_GetInteger(128)
    }
end function

'*****************************************************************
' Assertion helpers for roca tests
'
' Roca's built-in m.assert.* does not include isCloseTo or isInRange.
' These helpers fill the gap. Pass the roca test context `m` as `ctx`.
'
' Example:
'   assertCloseTo(m, result, 1.337, 0.01, "should be ~1.337")
'   assertInRange(m, timestamp, minMs, maxMs)
'*****************************************************************

' ----------------------------------------------------------------
' Asserts that actual is within offset of expected (inclusive).
' Equivalent to the old Assert.that(x).isCloseTo(expected, offset).
' @param ctx (object) roca test context — pass `m` from your m.it() sub.
' @param actual (float/double/integer) the value under test.
' @param expected (float/double/integer) the expected value.
' @param offset (float/double) the allowed absolute difference.
' @param msg (string) failure message; auto-generated if empty.
' ----------------------------------------------------------------
sub assertCloseTo(ctx as object, actual as dynamic, expected as dynamic, offset as dynamic, msg = "" as string)
    diff = Abs(actual - expected)
    if msg = ""
        msg = "Expected " + actual.toStr() + " to be within " + offset.toStr() + " of " + expected.toStr() + " (diff was " + diff.toStr() + ")"
    end if
    ctx.assert.isTrue(diff <= offset, msg)
end sub

' ----------------------------------------------------------------
' Asserts that actual is within [min, max] inclusive.
' Equivalent to the old Assert.that(x).isInRange(min, max).
' @param ctx (object) roca test context — pass `m` from your m.it() sub.
' @param actual (float/double/integer/longinteger) the value under test.
' @param minVal (float/double/integer/longinteger) lower bound (inclusive).
' @param maxVal (float/double/integer/longinteger) upper bound (inclusive).
' @param msg (string) failure message; auto-generated if empty.
' ----------------------------------------------------------------
sub assertInRange(ctx as object, actual as dynamic, minVal as dynamic, maxVal as dynamic, msg = "" as string)
    if msg = ""
        msg = "Expected " + actual.toStr() + " to be in range [" + minVal.toStr() + ", " + maxVal.toStr() + "]"
    end if
    ctx.assert.isTrue(actual >= minVal and actual <= maxVal, msg)
end sub
